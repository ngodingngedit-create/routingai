# --- Database ---
# Runtime: pakai connection string ber-pool (Neon pooled / PgBouncer)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Migrasi: pakai koneksi langsung tanpa pooler, wajib untuk prisma migrate deploy
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth (Better Auth) ---
# openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-hasil-rand-32-byte"
# URL publik aplikasi, tanpa trailing slash. Di produksi: https://routingai.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# --- URL publik aplikasi (opsional) ---
# Base URL yang ditampilkan di docs, homepage, dan panel kunci API.
# Kosongkan kalau mau otomatis diambil dari domain yang sedang diakses.
APP_URL=""

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Untuk produksi tambahkan: https://routingai.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Seed admin ---
# Email yang otomatis mendapat role ADMIN saat daftar pertama kali.
# Kosongkan kalau tidak mau admin dibuat dari seed.
ADMIN_EMAIL=""

# --- Enkripsi kredensial provider upstream (AES-256-GCM) ---
# openssl rand -hex 32
APP_ENCRYPTION_KEY=""

# --- Database cadangan (opsional) ---
# Dipakai oleh `npm run db:studio:backup` untuk browse database cadangan tanpa menyentuh produksi
BACKUP_DATABASE_URL=""

# --- Payment gateway (opsional, menyusul) ---
PAYMENT_PROVIDER=""
PAYMENT_SECRET_KEY=""
